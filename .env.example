# =============================================================================
# Jonjo — variáveis de ambiente
# Copie este arquivo para .env:   cp .env.example .env
# Os valores abaixo já funcionam para DESENVOLVIMENTO LOCAL (veja o README).
# NUNCA comite o .env — ele está no .gitignore.
# =============================================================================

# Porta da API/servidor Express.
PORT=3000

# Canal criado por padrão em cada servidor.
ROOM_NAME=geral

# --- LiveKit (servidor de mídia) ---------------------------------------------
# Chave e segredo PRECISAM ser iguais aos do arquivo de config do LiveKit
# (livekit.dev.yaml no ambiente local). Em produção, gere valores novos:
#   LIVEKIT_API_KEY=sala_$(openssl rand -hex 8)
#   LIVEKIT_API_SECRET=$(openssl rand -hex 32)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-local-only-not-for-production

# URL que o NAVEGADOR usa para falar com o LiveKit.
#   local:    ws://localhost:7880
#   produção: wss://seu-dominio.com
PUBLIC_LIVEKIT_URL=ws://localhost:7880

# URL que o SERVIDOR (Node) usa para consultar/criar salas no LiveKit.
#   local (npm run dev):     http://localhost:7880
#   produção (Docker):       http://livekit:7880  (nome do serviço/container)
LIVEKIT_INTERNAL_URL=http://localhost:7880

# --- Persistência ------------------------------------------------------------
# Arquivos JSON de dados. Sem estas variáveis, o servidor usa ./data/ (ignorado
# pelo git). Em produção com Docker, aponte para o volume:
#   CHANNELS_FILE=/data/channels.json
#   SERVERS_FILE=/data/servers.json
#   USERS_FILE=/data/users.json
# CHANNELS_FILE=
# SERVERS_FILE=
# USERS_FILE=

# --- Autenticação ------------------------------------------------------------
# Segredo que assina os cookies de sessão. Sem ele, cadastro e login ficam
# desativados. Em produção, gere um longo:  openssl rand -hex 32
SESSION_SECRET=dev-session-secret-local-only

# Usuário que vira "presidente" (admin) ao se cadastrar.
# Vazio = o primeiro usuário a se cadastrar vira presidente.
PRESIDENT_USERNAME=

# --- Frontend (lido no build pelo Vite) ---------------------------------------
# Chave PIX do widget "Apoie o Jonjo". Vazio = widget oculto.
VITE_PIX_KEY=
